    <style>
        /* --- CSS Variables & Theming --- */
        :root {
            --bg-color: #f9fafb;
            --card-bg: #ffffff;
            --text-main: #1f2937;
            --text-muted: #4b5563;
            --primary: #2563eb;
            --primary-hover: #1d4ed8;
            --border-color: #e5e7eb;
            --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            --transition: all 0.3s ease;
        }

        [data-theme="dark"] {
            --bg-color: #111827;
            --card-bg: #1f2937;
            --text-main: #f9fafb;
            --text-muted: #9ca3af;
            --primary: #3b82f6;
            --primary-hover: #60a5fa;
            --border-color: #374151;
            --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.5);
        }

        /* --- Reset & Base Styles --- */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            transition: var(--transition);
            line-height: 1.5;
        }

        header {
            display: flex;
            justify-content: flex-end;
            padding: 20px 5%;
            background-color: var(--card-bg);
            border-bottom: 1px solid var(--border-color);
        }

        /* --- Theme Toggle Button --- */
        .theme-btn {
            background: none;
            border: 1px solid var(--border-color);
            padding: 8px 16px;
            border-radius: 20px;
            cursor: pointer;
            color: var(--text-main);
            font-weight: 500;
            transition: var(--transition);
        }
        .theme-btn:hover {
            background-color: var(--border-color);
        }

        /* --- Main Layout --- */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 60px 20px;
        }

        .hero {
            text-align: center;
            margin-bottom: 60px;
        }

        .hero h1 {
            font-size: 2.5rem;
            margin-bottom: 15px;
            color: var(--text-main);
        }

        .hero p {
            font-size: 1.1rem;
            color: var(--text-muted);
            max-width: 600px;
            margin: 0 auto;
        }

        /* --- Services Grid --- */
        .services-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
        }

        .service-card {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 30px;
            box-shadow: var(--shadow);
            transition: var(--transition);
            display: flex;
            flex-direction: column;
        }

        .service-card:hover {
            transform: translateY(-5px);
            border-color: var(--primary);
        }

        /* --- Card Thumbnails (SVG Placeholders) --- */
        .thumbnail-wrapper {
            width: 60px;
            height: 60px;
            background-color: rgba(37, 99, 235, 0.1);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 20px;
            color: var(--primary);
            transition: var(--transition);
        }

        [data-theme="dark"] .thumbnail-wrapper {
            background-color: rgba(59, 130, 246, 0.15);
        }

        .thumbnail-wrapper svg {
            width: 32px;
            height: 32px;
            fill: currentColor;
        }

        /* --- Card Typography & Buttons --- */
        .service-card h2 {
            font-size: 1.35rem;
            margin-bottom: 12px;
            color: var(--text-main);
        }

        .service-card p {
            color: var(--text-muted);
            font-size: 0.95rem;
            margin-bottom: 25px;
            flex-grow: 1; /* Pushes button to the bottom */
        }

        .cta-btn {
            display: inline-block;
            text-align: center;
            background-color: var(--primary);
            color: #ffffff;
            padding: 10px 20px;
            border-radius: 6px;
            text-decoration: none;
            font-weight: 500;
            transition: var(--transition);
            border: none;
            cursor: pointer;
        }

        .cta-btn:hover {
            background-color: var(--primary-hover);
        }
    </style>
</head>
